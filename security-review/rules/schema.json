{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Security Review Rule",
  "type": "object",
  "required": ["id", "name", "severity"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "severity": {
      "enum": ["critical", "high", "medium", "low", "info"]
    },
    "cwe": { "type": "string" },
    "owasp": { "type": "string" },
    "languages": { "type": "array", "items": { "type": "string" } },
    "frameworks": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "detect": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "file_contains", "file_not_contains",
              "line_matches", "line_not_matches",
              "regex_in_file", "file_exists", "value_equals"
            ]
          },
          "path": { "type": "string" },
          "pattern": { "type": "string" },
          "key": { "type": "string" },
          "value": { "type": "string" },
          "exclude_extensions": { "type": "array", "items": { "type": "string" } },
          "exclude_paths": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "fix": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": {
            "enum": [
              "edit", "uncomment", "insert", "insert_after",
              "insert_before", "config", "replace_with_env_var",
              "add_to_gitignore"
            ]
          },
          "description": { "type": "string" },
          "file": { "type": "string" },
          "search": { "type": "string" },
          "replacement": { "type": "string" },
          "pattern": { "type": "string" },
          "anchor": { "type": "string" },
          "text": { "type": "string" },
          "position": { "type": "string" },
          "effort": { "enum": ["low", "medium", "high"] }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
